# Hardware: ESP32-S3 N16R8 (16 MiB Flash).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Bound TCP connection establishment in the Modbus worker.
CONFIG_FMB_TCP_CONNECTION_TOUT_SEC=2

CONFIG_INGAWAY_MQTT_BROKER_URI="mqtts://10.30.192.176"

# HTTPS OTA: direct S3/CloudFront .bin URL for ESP32-S3 ingaway firmware.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_INGAWAY_OTA_ENABLED=y
CONFIG_INGAWAY_OTA_URL="https://example.com/ingaway/esp32s3/ingaway.bin"
CONFIG_INGAWAY_OTA_PROJECT_NAME="ingaway"
CONFIG_INGAWAY_OTA_REQUIRED_FLASH_MB=16
